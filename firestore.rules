rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only see and change their own drinks and settings.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /entries/{entryId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.ts is number
          && request.resource.data.ml is number && request.resource.data.ml > 0 && request.resource.data.ml <= 5000
          && request.resource.data.abv is number && request.resource.data.abv >= 0 && request.resource.data.abv <= 100;
      }
    }
  }
}
